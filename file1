

#!/bin/bash

echo "==========================================="
echo "   Vault Secret Creator (Local Utility)    "
echo "==========================================="
echo ""

# 1. Interactive Prompts
read -p "Enter target K8s Namespace (e.g., cib-gps-platform-observability-preprod): " TARGET_NS
read -p "Enter K8s Service Account (e.g., cib-gps-platform-observability): " SA_NAME
read -p "Enter Vault Role Name (e.g., cib-gps-platform-observability-role): " VAULT_ROLE
read -p "Enter the new Secret Name (e.g., pol-sms-payos-ui): " SECRET_NAME
read -p "Enter the JSON payload filename (e.g., data.json): " JSON_FILE

echo ""

# 2. Input Validation
if [ ! -f "$JSON_FILE" ]; then
  echo "❌ Error: File '$JSON_FILE' not found in the current directory!"
  exit 1
fi

# 3. Generate K8s Token
echo "[1/3] Requesting temporary JWT from Kubernetes for $SA_NAME..."
SA_JWT_token=$(kubectl create token "$SA_NAME" -n "$TARGET_NS" 2>/dev/null)

if [ -z "$SA_JWT_token" ]; then
  echo "❌ Error: Failed to get K8s token. Check if the Service Account and Namespace exist."
  exit 1
fi

# 4. Login to Vault
echo "[2/3] Authenticating with UAT Vault..."
LOGIN_RESPONSE=$(curl -s -X 'POST' \
  'https://vault-uat.uk.hsbc:8200/v1/auth/kubernetes/wsit_uk-azs-305/login' \
  -H 'accept: */*' \
  -H 'Content-Type: application/json' \
  -H 'X-Vault-Namespace: ITID/12385199_DTPENGG' \
  -d '{
  "jwt": "'"$SA_JWT_token"'",
  "role": "'"$VAULT_ROLE"'"
}')

VAULT_TOKEN=$(echo "$LOGIN_RESPONSE" | grep -o '"client_token":"[^"]*"' | cut -d'"' -f4)

if [ -z "$VAULT_TOKEN" ]; then
  echo "❌ Error: Vault login failed. Please verify your Role and Auth path."
  exit 1
fi

# 5. Create the Secret
echo "[3/3] Writing secret to Vault..."
# Notice the path now uses $TARGET_NS and $SECRET_NAME dynamically
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -X 'POST' \
  "https://vault-uat.uk.hsbc:8200/v1/secrets/kv_v2/wsit/data/$TARGET_NS/$SECRET_NAME" \
  -H 'accept: application/json' \
  -H "X-Vault-Token: $VAULT_TOKEN" \
  -H 'X-Vault-Namespace: ITID/12385199_DTPENGG' \
  -H 'Content-Type: application/json' \
  -d "@$JSON_FILE")

if [ "$HTTP_STATUS" -ne 200 ]; then
  echo "❌ Error: Failed to write secret. Vault returned HTTP status: $HTTP_STATUS"
  exit 1
fi

# 6. Success Summary
echo ""
echo "==========================================="
echo " ✅ SUCCESS! Secret successfully created."
echo "==========================================="
echo " Environment:  UAT (uk-azs-305)"
echo " Namespace:    $TARGET_NS"
echo " Secret Name:  $SECRET_NAME"
echo " UI Path:      secrets/kv_v2/wsit/$TARGET_NS/$SECRET_NAME"
echo " Payload File: $JSON_FILE"
echo "==========================================="
